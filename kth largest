kth largest.

import java.util.Arrays;

public class Main {
    public static void main(String[] args) {
        int[] arr = {7, 10, 4, 3, 20, 15};
        int k = 2;

        Arrays.sort(arr);

        int n = arr.length;
        System.out.println("Kth largest = " + arr[n - k]);
    }
}

